
{
  "manifest_version": 3,
  "name": "Semantic AI Agent Widget",
  "version": "1.0",
  "description": "AI widget that follows you across websites to find relevant content.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:5000/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ]
}